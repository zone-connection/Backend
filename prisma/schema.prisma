  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, nome])
  @@map("interessados_usado")
}

/// Operação de comercialização do mesmo Imovel da captação.
model VendaUsado {
  id                   String           @id @default(uuid())
  tenantId             String
  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  imovelId             String           @unique
  imovel               Imovel           @relation(fields: [imovelId], references: [id], onDelete: Restrict)
  responsavelId        String
  responsavel          User             @relation("VendaUsadoResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict)
  funilId              String
  funil                Funil            @relation(fields: [funilId], references: [id], onDelete: Restrict)
  funilEtapaId         String
  funilEtapa           FunilEtapa       @relation(fields: [funilEtapaId], references: [id], onDelete: Restrict)
  status               VendaUsadoStatus @default(disponivel)
  precoVenda           Decimal?         @db.Decimal(14, 2)
  dataDisponibilizacao DateTime         @default(now())
  observacoes          String           @default("")

  stageEnteredAt    DateTime @default(now())
  lastStageChangeAt DateTime @default(now())
  lastMovementAt    DateTime @default(now())
  lastHistoricoAt   DateTime?
  prazoDueAt        DateTime?
  alertaProximoAt   DateTime?
  prazoAdiado       Boolean  @default(false)

  vinculos   VendaUsadoVinculo[]
  historicos VendaUsadoHistorico[]
  visitas    VendaUsadoVisita[]
  propostas  VendaUsadoProposta[]
  fechamento VendaUsadoFechamento?
  chaveMovimentos ImovelChaveMovimento[]
  posVenda   VendaUsadoPosVenda?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, responsavelId])
  @@index([tenantId, funilEtapaId])
  @@index([tenantId, lastMovementAt])
  @@index([tenantId, prazoDueAt])
  @@map("vendas_usado")
}

model VendaUsadoVinculo {
