  @@map("venda_usado_pos_vendas")
}

model VendaUsadoPosVendaPendencia {
  id            String                             @id @default(uuid())
  tenantId      String
  tenant        Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posVendaId    String
  posVenda      VendaUsadoPosVenda                 @relation(fields: [posVendaId], references: [id], onDelete: Cascade)
  titulo        String
  descricao     String                             @default("")
  status        VendaUsadoPosVendaPendenciaStatus  @default(pendente)
  obrigatoria   Boolean                            @default(false)
  responsavelId String?
  responsavel   User?                              @relation("VendaUsadoPosVendaPendenciaResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  prazo         DateTime?
  concluidaEm   DateTime?
  observacao    String                             @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, posVendaId])
  @@index([posVendaId, status])
  @@map("venda_usado_pos_venda_pendencias")
}

/// Item de catálogo (etapa do funil, origem, motivo de perda, tag).
/// Os leads guardam apenas os labels como string — sem FK — para preservar
/// o histórico caso um item seja renomeado ou desativado.
model CatalogItem {
  id        String      @id @default(uuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      CatalogType
  label     String
  slug      String? // usado nas etapas do funil (ex.: "visita-agendada")
  color     String? // classes Tailwind das badges do funil
  sortOrder Int         @default(0)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([tenantId, type, label])
  @@index([tenantId])
  @@index([type, sortOrder])
  @@map("catalog_items")
}

/// Meta comercial por escopo (corretor, gerente/equipe ou imobiliária).
model Meta {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  escopo MetaEscopo @default(corretor)

  corretorId String?
  corretor   User?   @relation("MetaCorretor", fields: [corretorId], references: [id], onDelete: Cascade)

  gerenteId String?
  gerente   User?   @relation("MetaGerente", fields: [gerenteId], references: [id], onDelete: Cascade)

  criadorId String
  criador   User   @relation("MetaCriador", fields: [criadorId], references: [id], onDelete: Cascade)

  origem  MetaOrigem
  tipo    MetaTipo
  periodo MetaPeriodo
  valor   Int

  inicio DateTime
  fim    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([escopo])
  @@index([corretorId, inicio, fim])
  @@index([gerenteId, inicio, fim])
  @@index([criadorId])
  @@map("metas")
}

/// Tipo de parceiro no módulo financeiro.
enum FinanceiroParceiroTipo {
  cliente
  fornecedor
  ambos
}

/// Status de título / movimento financeiro.
enum FinanceiroTituloStatus {
  aberto
  pago
  atrasado
  cancelado
}

/// Contas a receber vs a pagar.
enum FinanceiroTituloTipo {
  receber
  pagar
}

enum FinanceiroMovimentoTipo {
  entrada
  saida
}

enum FinanceiroComissaoStatus {
  pendente
  liberada
  paga
}

/// Natureza do tipo de despesa no centro de custos.
enum FinanceiroDespesaNatureza {
  fixa
  /// Recorrente todo mês, mas com valor que muda.
  fixa_variavel
  variavel
}

/// Cliente / fornecedor do módulo financeiro.
model FinanceiroParceiro {
  id          String                 @id @default(uuid())
  tenantId    String
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome        String
  documento   String
  tipo        FinanceiroParceiroTipo
  email       String?
  telefone    String?
  cidade      String?
  /// Imobiliária associada (opcional) — texto livre ou nome do tenant.
  imobiliaria String                 @default("")
  saldoAberto Float                  @default(0)
  ativo       Boolean                @default(true)

  movimentos FinanceiroMovimento[]
  titulos    FinanceiroTitulo[]
  contratosFornecedor PlatformFornecedorContrato[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, tipo])
  @@index([tenantId, ativo])
  @@index([nome])
  @@map("financeiro_parceiros")
}

/// Lançamento de movimentação financeira.
model FinanceiroMovimento {
  id             String                  @id @default(uuid())
  tenantId       String
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  data           DateTime
  descricao      String
  parceiroId     String?
  parceiro       FinanceiroParceiro?     @relation(fields: [parceiroId], references: [id], onDelete: SetNull)
  parceiroNome   String                  @default("")
  categoria      String
  centro         String                  @default("")
  tipo           FinanceiroMovimentoTipo
  valor          Float
  status         FinanceiroTituloStatus  @default(aberto)
  formaPagamento String                  @default("")
  /// Baixa de título (evita double-count no fluxo).
  tituloId       String?                 @unique
  titulo         FinanceiroTitulo?       @relation(fields: [tituloId], references: [id], onDelete: SetNull)
  /// Classificação da despesa (só saídas): fixa ou variável.
  natureza       FinanceiroDespesaNatureza?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, data])
  @@index([parceiroId])
  @@map("financeiro_movimentos")
}

/// Título a receber ou a pagar.
model FinanceiroTitulo {
  id            String                 @id @default(uuid())
  tenantId      String
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo          FinanceiroTituloTipo
  descricao     String
  parceiroId    String?
  parceiro      FinanceiroParceiro?    @relation(fields: [parceiroId], references: [id], onDelete: SetNull)
  parceiroNome  String                 @default("")
  categoria     String                 @default("")
  centro        String                 @default("")
  vencimento    DateTime
  dataPagamento DateTime?
  valor         Float
  status          FinanceiroTituloStatus @default(aberto)
  parcela         String                 @default("")
  /// Liga parcelas do mesmo contrato (N títulos com o mesmo UUID).
  grupoParcelasId String?
  /// Recorrência mensal sem data de término: o sistema segue gerando os próximos meses.
  recorrenciaIndeterminada Boolean @default(false)
  /// Contrato da plataforma que originou este título (adesão/mensalidade).
  platformContratoId String?
  platformContrato   PlatformContrato?   @relation(fields: [platformContratoId], references: [id], onDelete: SetNull)
  /// Contrato de fornecedor da plataforma que originou este título a pagar.
  platformFornecedorContratoId String?
  platformFornecedorContrato   PlatformFornecedorContrato? @relation(fields: [platformFornecedorContratoId], references: [id], onDelete: SetNull)
  movimento       FinanceiroMovimento?
  /// Comissão que originou este título (várias fatias por comissão).
  comissaoId      String?
  comissao        FinanceiroComissao?    @relation(fields: [comissaoId], references: [id], onDelete: SetNull)
  /// Fatia da comissão: caixa | socios | corretor | gerente | tributos.
  comissaoPapel   String?
  /// Classificação da despesa (só títulos a pagar): fixa ou variável.
  natureza        FinanceiroDespesaNatureza?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, tipo])
  @@index([tenantId, vencimento])
  @@index([tenantId, grupoParcelasId])
  @@index([parceiroId])
  @@index([platformContratoId])
  @@index([platformFornecedorContratoId])
  @@index([comissaoId])
  @@unique([comissaoId, comissaoPapel])
  @@map("financeiro_titulos")
}

/// Categoria de título / movimento (entrada = a receber, saida = a pagar).
model FinanceiroCategoria {
  id       String                   @id @default(uuid())
  tenantId String
  tenant   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome     String
  tipo     FinanceiroMovimentoTipo
  ativo    Boolean                  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, nome, tipo])
  @@index([tenantId])
  @@index([tenantId, tipo])
  @@index([tenantId, ativo])
  @@map("financeiro_categorias")
}

/// Tipo / centro de despesa (fixa ou variável).
model FinanceiroDespesaTipo {
  id           String                     @id @default(uuid())
  tenantId     String
  tenant       Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome         String
  natureza     FinanceiroDespesaNatureza
  /// Orçamento mensal de referência para o tipo.
  orcadoMensal Float                      @default(0)
  ativo        Boolean                    @default(true)
  despesas     FinanceiroDespesa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, nome, natureza])
  @@index([tenantId])
  @@index([tenantId, natureza])
  @@map("financeiro_despesa_tipos")
}

/// Lançamento de despesa vinculado a um tipo (fixa/variável).
model FinanceiroDespesa {
  id          String                @id @default(uuid())
  tenantId    String
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipoId      String
  tipo        FinanceiroDespesaTipo @relation(fields: [tipoId], references: [id], onDelete: Cascade)
  descricao   String
  valor       Float
  data        DateTime
  /// Competência contábil (YYYY-MM).
  competencia String                @default("")
  /// Se true, entra no botão "Renovar mês".
  recorrente  Boolean               @default(false)
  /// Despesa-raiz da série recorrente (null = esta é a raiz).
  origemId    String?
  origem      FinanceiroDespesa?    @relation("DespesaSerie", fields: [origemId], references: [id], onDelete: SetNull)
  renovacoes  FinanceiroDespesa[]   @relation("DespesaSerie")
  observacao  String                @default("")
  ativo       Boolean               @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, data])
  @@index([tenantId, competencia])
  @@index([tipoId])
  @@index([origemId])
  @@map("financeiro_despesas")
}

/// Tipo / categoria de recebimento (centro de recebimentos).
model FinanceiroRecebimentoTipo {
  id           String                     @id @default(uuid())
  tenantId     String
  tenant       Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome         String
  natureza     FinanceiroDespesaNatureza
  orcadoMensal Float                      @default(0)
  ativo        Boolean                    @default(true)
  recebimentos FinanceiroRecebimento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, nome, natureza])
  @@index([tenantId])
  @@index([tenantId, natureza])
  @@map("financeiro_recebimento_tipos")
}

/// Lançamento de recebimento vinculado a um tipo.
model FinanceiroRecebimento {
  id          String                     @id @default(uuid())
  tenantId    String
  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipoId      String
  tipo        FinanceiroRecebimentoTipo  @relation(fields: [tipoId], references: [id], onDelete: Cascade)
  descricao   String
  valor       Float
  data        DateTime
  competencia String                     @default("")
  recorrente  Boolean                    @default(false)
  origemId    String?
  origem      FinanceiroRecebimento?     @relation("RecebimentoSerie", fields: [origemId], references: [id], onDelete: SetNull)
  renovacoes  FinanceiroRecebimento[]    @relation("RecebimentoSerie")
  observacao  String                     @default("")
  ativo       Boolean                    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, data])
  @@index([tenantId, competencia])
  @@index([tipoId])
  @@index([origemId])
  @@map("financeiro_recebimentos")
}

/// Comissão originada de uma documentação vendida.
model FinanceiroComissao {
  id              String                   @id @default(uuid())
  tenantId        String
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentacaoId  String
  documentacao    Documentacao             @relation(fields: [documentacaoId], references: [id], onDelete: Restrict)
  corretorId      String
  corretorUsuario User                     @relation("ComissaoCorretor", fields: [corretorId], references: [id], onDelete: Restrict)
  gerenteId       String?
  gerenteUsuario  User?                    @relation("ComissaoGerente", fields: [gerenteId], references: [id], onDelete: SetNull)
  equipeId        String?
  equipeRegistro  Equipe?                  @relation(fields: [equipeId], references: [id], onDelete: SetNull)
  corretor        String
  gerente         String                   @default("")
  equipe          String                   @default("")
  empreendimento  String                   @default("")
  cliente         String                   @default("")
  dataVenda                 DateTime
  dataPrevistaRecebimento   DateTime
  vgv                   Decimal                  @db.Decimal(18, 2)
  percentualImobiliaria Decimal                  @db.Decimal(7, 4)
  comissaoBruta         Decimal                  @db.Decimal(18, 2)
  percentualTributos    Decimal                  @db.Decimal(7, 4)
  valorTributos         Decimal                  @db.Decimal(18, 2)
  comissaoLiquida       Decimal                  @db.Decimal(18, 2)
  percentualCorretor    Decimal                  @db.Decimal(7, 4)
  valorCorretor         Decimal                  @db.Decimal(18, 2)
  percentualGerente     Decimal                  @db.Decimal(7, 4)
  valorGerente          Decimal                  @db.Decimal(18, 2)
  percentualCaixa       Decimal                  @db.Decimal(7, 4)
  valorCaixa            Decimal                  @db.Decimal(18, 2)
  percentualSocios      Decimal                  @db.Decimal(7, 4)
  valorSocios           Decimal                  @db.Decimal(18, 2)
  valorPremiacao                  Decimal @default(0) @db.Decimal(18, 2)
  percentualPremiacaoCorretor     Decimal @default(0) @db.Decimal(7, 4)
  valorPremiacaoCorretor          Decimal @default(0) @db.Decimal(18, 2)
  percentualPremiacaoImposto      Decimal @default(0) @db.Decimal(7, 4)
  valorPremiacaoImposto           Decimal @default(0) @db.Decimal(18, 2)
  percentualPremiacaoImobiliaria  Decimal @default(0) @db.Decimal(7, 4)
  valorPremiacaoImobiliaria       Decimal @default(0) @db.Decimal(18, 2)
  percentualPremiacaoGerente      Decimal @default(0) @db.Decimal(7, 4)
  valorPremiacaoGerente           Decimal @default(0) @db.Decimal(18, 2)
  valorPremiacaoRestante          Decimal @default(0) @db.Decimal(18, 2)
  status          FinanceiroComissaoStatus @default(pendente)
  titulos         FinanceiroTitulo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, dataVenda])
  @@index([tenantId, dataPrevistaRecebimento])
  @@index([documentacaoId])
  @@index([corretorId])
  @@index([gerenteId])
  @@index([equipeId])
  @@map("financeiro_comissoes")
}

/// Tipo de acordo comercial plataforma ↔ imobiliária.
enum PlatformContratoTipo {
  assinatura
  financeiro
}

/// Ciclo de vida do acordo (proposta = negociação; ativo = fechado).
enum PlatformContratoStatus {
  proposta
  ativo
  atrasado
  suspenso
  cancelado
  encerrado
}

/// Contrato / proposta comercial entre Zone Connection e uma imobiliária.
model PlatformContrato {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  codigo String
  titulo String
  tipo   PlatformContratoTipo

  /// Plano da assinatura (quando tipo = assinatura).
  plano TenantPlano?

  valor            Float
  /// Valor fechado da adesão (entrada).
  valorAdesao      Float                  @default(0)
  /// Valor fechado da mensalidade.
  valorMensalidade Float                  @default(0)
  dataInicio DateTime
  vencimento DateTime?
  status     PlatformContratoStatus @default(proposta)
  observacao String                 @default("")

  parcelas PlatformContratoParcela[]
  titulos  FinanceiroTitulo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([codigo])
  @@index([tenantId])
  @@index([status])
  @@index([vencimento])
  @@map("platform_contratos")
}

/// Parcela de um contrato da plataforma.
model PlatformContratoParcela {
  id         String                 @id @default(uuid())
  contratoId String
  contrato   PlatformContrato       @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  numero     Int
  valor      Float
  vencimento DateTime
  status     FinanceiroTituloStatus @default(aberto)
  dataPagamento  DateTime?
  formaPagamento String             @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contratoId, numero])
  @@index([contratoId])
  @@index([vencimento])
  @@map("platform_contrato_parcelas")
}

/// Contrato recorrente da plataforma com um fornecedor, sem vínculo com imobiliária.
model PlatformFornecedorContrato {
  id         String @id @default(uuid())
  codigo     String @unique
  titulo     String
  parceiroId String
  parceiro   FinanceiroParceiro @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  centro     String
  valorAdesao Float @default(0)
  valorMensalidade Float
  qtdMensalidades Int
  dataInicio DateTime
  vencimento DateTime
  status PlatformContratoStatus @default(ativo)
  observacao String @default("")

  parcelas PlatformFornecedorContratoParcela[]
  titulos FinanceiroTitulo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parceiroId])
  @@index([status])
  @@index([vencimento])
  @@map("platform_fornecedor_contratos")
}

/// Parcela programada de um contrato de fornecedor.
model PlatformFornecedorContratoParcela {
  id String @id @default(uuid())
  contratoId String
  contrato PlatformFornecedorContrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  numero Int
  descricao String
  valor Float
  vencimento DateTime
  status FinanceiroTituloStatus @default(aberto)
  dataPagamento DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contratoId, numero])
  @@index([contratoId])
  @@index([vencimento])
  @@map("platform_fornecedor_contrato_parcelas")
}

/// Motivo de uma tentativa de login recusada (para auditoria).
enum LoginFailureReason {
  senha_incorreta
  usuario_inexistente
  conta_bloqueada
  usuario_inativo
}

/// Trilha de auditoria de acessos — permite detectar ataques de força bruta.
model LoginAttempt {
  id        String              @id @default(uuid())
  email     String
  success   Boolean
  reason    LoginFailureReason?
  ip        String?
  userAgent String?
  createdAt DateTime            @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

/// Pasta / seção do Treinamento (árvore por tenant).
model TreinamentoSecao {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  parentId String?
  parent   TreinamentoSecao?  @relation("TreinamentoArvore", fields: [parentId], references: [id], onDelete: Cascade)
  children TreinamentoSecao[] @relation("TreinamentoArvore")

  titulo    String
  sortOrder Int     @default(0)
  links     TreinamentoLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, parentId])
  @@index([tenantId, sortOrder])
  @@map("treinamento_secoes")
}

/// Link (Drive ou outro material) dentro de uma seção de treinamento.
model TreinamentoLink {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  secaoId String
  secao   TreinamentoSecao @relation(fields: [secaoId], references: [id], onDelete: Cascade)

  titulo    String
  url       String
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, secaoId])
  @@index([secaoId, sortOrder])
  @@map("treinamento_links")
}
