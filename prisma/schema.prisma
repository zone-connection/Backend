/// Comprador de imóveis usados (não é o Lead comercial de lançamentos).
model InteressadoUsado {
  id            String              @id @default(uuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome          String
  telefone      String              @default("")
  email         String              @default("")
  observacoes   String              @default("")
  tipoDesejado  CaptacaoImovelTipo?
  cidade        String              @default("")
  bairros       String              @default("")
  precoMin      Decimal?            @db.Decimal(14, 2)
  precoMax      Decimal?            @db.Decimal(14, 2)
  quartosMin    Int?
  banheirosMin  Int?
  vagasMin      Int?
  areaMin       Decimal?            @db.Decimal(12, 2)

  vinculos  VendaUsadoVinculo[]
  visitas   VendaUsadoVisita[]
  propostas VendaUsadoProposta[]
  fechamentos VendaUsadoFechamento[]
  posVendas VendaUsadoPosVenda[]

