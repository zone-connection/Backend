// Prisma schema — CRM New Palace
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Perfis de acesso (RBAC). Espelha os perfis usados no frontend.
/// super_admin = plataforma Zone Connection (sem tenant).
enum Role {
  super_admin
  admin
  gerente
  corretor
  analista
  /// Cadastro operacional limitado: construtoras, empreendimentos, origens e tags.
  treinee
  /// Acesso exclusivo ao módulo Financeiro da imobiliária.
  financeiro
  /// Extra do plano Solo: acesso só pelos módulos/ações liberados pelo admin.
  assistente
}

/// Situação do usuário no sistema.
enum UserStatus {
  ativo
  inativo
}

/// Andamento da obtenção do CRECI do usuário.
enum CreciProcessoStatus {
  nao_iniciado
  envio_documentacao
  pagamento_boleto
  aguardando_creci
  creci_recebido
}

/// Plano comercial do tenant (define módulos base e cota de usuários).
enum TenantPlano {
  solo
  bronze
  prata
  ouro
}

/// Origem da meta: criada pelo corretor ou atribuída pelo gerente.
enum MetaOrigem {
  pessoal
  gerente
  admin
}

/// Alvo da meta comercial.
enum MetaEscopo {
  corretor
  gerente
  imobiliaria
}

/// Indicador acompanhado pela meta comercial.
enum MetaTipo {
  vendas
  documentacoes
  vgv
}

/// Recorrência do período ativo da meta.
enum MetaPeriodo {
  diaria
  semanal
  mensal
  trimestral
  semestral
  anual
}

/// Lead de captação vs cliente da carteira pessoal do corretor.
/// Ambos entram no funil; listas de Leads e Clientes ficam separadas.
enum ContatoTipo {
  lead
  cliente
}

/// Unidade de prazo de permanência na etapa ou de inatividade do lead.
enum PrazoUnidade {
  minutos
  horas
  dias
}

/// Imobiliária / empresa cliente da plataforma (tenant).
model Tenant {
  id     String     @id @default(uuid())
  name   String
  slug   String     @unique
  status UserStatus @default(ativo)
  /// CPF ou CNPJ do cliente (imobiliária).
  documento String  @default("")
  /// CRECI da imobiliária (ex.: 18937-J).
  creci String @default("")
  /// E-mail institucional da imobiliária.
  email String @default("")
  /// Telefone/WhatsApp da imobiliária.
  telefone String @default("")
  /// Endereço completo (rua, bairro, cidade/UF).
  endereco String @default("")
  /// Cidade do contrato (ex.: Recife/PE).
  cidade String @default("")

  /// Branding visual (nível 1).
  logoUrl      String?
  /// Public ID no Cloudinary (upload da logo da imobiliária).
  logoPublicId String?
  /// Cor primária em hex (#RRGGBB). Null = tema padrão da plataforma.
  primaryColor String?

  /// Layout configurável (nível 2).
  /// default | dark | compact
  sidebarStyle String @default("default")
  /// comfortable | compact
  density      String @default("comfortable")
  /// Rota inicial após login (ex.: /dashboard, /funil).
  homePath     String @default("/dashboard")
  /// Módulos do plano + operações: { "funil": true, "captacao": false, "comercial": true, ... }
  modules      Json?

  /// Plano: solo (corretor), bronze (CRM), prata (CRM+admin), ouro (tudo).
  plano TenantPlano @default(bronze)
  /// Cota base de usuários do plano (1 / 5 / 15 / 30).
  maxUsuarios Int @default(5)
  /// Usuários extras liberados pelo super_admin além da cota base.
  usuariosExtras Int @default(0)
  /// Tenant pode conectar bot de IA (WhatsApp/OZap IA).
  iaBotEnabled Boolean @default(false)
  /// Cliente de teste/demonstração (separado dos clientes reais na gestão).
  isTest Boolean @default(false)

  users             User[]
  equipes           Equipe[]
  leads             Lead[]
  construtoras      Construtora[]
  empreendimentos   Empreendimento[]
  localidades       Localidade[]
  catalogItems      CatalogItem[]
  funis             Funil[]
  leadPrazoAdiamentos LeadPrazoAdiamento[]
  documentacoes     Documentacao[]
  propostas         Proposta[]
  analises          Analise[]
  agendamentos      Agendamento[]
  notificacoes      Notificacao[]
  metas             Meta[]
  metaConnections   TenantMetaConnection[]
  ozapConnections   TenantOzapConnection[]
  oruloConnections  TenantOruloConnection[]
  financeiroParceiros     FinanceiroParceiro[]
  financeiroMovimentos    FinanceiroMovimento[]
  financeiroTitulos       FinanceiroTitulo[]
  financeiroComissoes     FinanceiroComissao[]
  financeiroDespesaTipos       FinanceiroDespesaTipo[]
  financeiroDespesas           FinanceiroDespesa[]
  financeiroRecebimentoTipos   FinanceiroRecebimentoTipo[]
  financeiroRecebimentos       FinanceiroRecebimento[]
  financeiroCategorias         FinanceiroCategoria[]
  platformContratos            PlatformContrato[]
  sessionSegments         UserSessionSegment[]
  treinamentoSecoes       TreinamentoSecao[]
  treinamentoLinks        TreinamentoLink[]
  proprietarios           Proprietario[]
  imoveisCaptacao         Imovel[]
  imovelFotos             ImovelFoto[]
  captacoes               Captacao[]
  captacaoHistoricos      CaptacaoHistorico[]
  vendasUsado             VendaUsado[]
  interessadosUsado       InteressadoUsado[]
  vendaUsadoVinculos      VendaUsadoVinculo[]
  vendaUsadoHistoricos    VendaUsadoHistorico[]
  vendaUsadoVisitas       VendaUsadoVisita[]
  vendaUsadoPropostas     VendaUsadoProposta[]
  vendaUsadoNegociacoes   VendaUsadoNegociacao[]
  vendaUsadoNegociacaoMovimentos VendaUsadoNegociacaoMovimento[]
  vendaUsadoFechamentos          VendaUsadoFechamento[]
  vendaUsadoDocumentos           VendaUsadoDocumento[]
  vendaUsadoContratos            VendaUsadoContrato[]
  imovelChaves                   ImovelChave[]
  imovelChaveMovimentos          ImovelChaveMovimento[]
  vendaUsadoPosVendas            VendaUsadoPosVenda[]
  vendaUsadoPosVendaPendencias   VendaUsadoPosVendaPendencia[]
  proprietarioPortalAcessos      ProprietarioPortalAcesso[]
  equipeFunis                    EquipeFunil[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isTest])
  @@map("tenants")
}

/// Página Meta Lead Ads vinculada a um tenant (roteamento por pageId).
model TenantMetaConnection {
  id                String    @id @default(uuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pageId            String    @unique
  pageAccessToken   String
  pageName          String?
  adAccountId       String?
  adAccountName     String?
  connectedByUserId String?
  tokenExpiresAt    DateTime?
  ativo             Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("tenant_meta_connections")
}

/// Instância OZap vinculada a um tenant (roteamento por instanceId).
model TenantOzapConnection {
  id         String  @id @default(uuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instanceId Int     @unique
  ativo      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("tenant_ozap_connections")
}

/// Credenciais Órulo (oruloClientAuth) por imobiliária.
model TenantOruloConnection {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId        String    @unique
  clientSecret    String
  accessToken     String?
  ativo           Boolean   @default(true)
  lastFullSyncAt  DateTime?
  lastReconcileAt DateTime?
  lastError       String?
  syncing         Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId])
  @@index([tenantId])
  @@map("tenant_orulo_connections")
}

/// Token oruloEndUserAuth do corretor (dados comerciais em tempo real).
model UserOruloToken {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId    String
  accessToken String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("user_orulo_tokens")
}

/// Usuário do sistema (login, RBAC e gestão de equipe).
/// tenantId é obrigatório para roles de imobiliária; null só para super_admin.
model User {
  id        String     @id @default(uuid())
  tenantId  String?
  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String
  password  String
  phone     String?
  /// WhatsApp do corretor (admin cadastra; usado para enviar resultado da análise).
  whatsapp  String?
  /// Data de nascimento (útil no cadastro de corretor e demais usuários).
  dataNascimento DateTime?
  cargo     String?
  /// CRECI do corretor/usuário, quando informado no cadastro.
  creci     String?
  /// Etapa atual do processo de obtenção do CRECI.
  creciStatus CreciProcessoStatus @default(nao_iniciado)
  /// Cor de destaque em hex (#RRGGBB) para badges (ex.: Documentação).
  cor       String?
  /// Preferências visuais pessoais em hex (#RRGGBB).
  corAside     String?
  corPrincipal String?
  corModulo    String?
  role      Role       @default(corretor)
  status    UserStatus @default(ativo)
  avatar    String?
  /// Permissões do perfil financeiro (ignoradas nos demais perfis).
  financeiroCanView   Boolean @default(true)
  financeiroCanCreate Boolean @default(true)
  financeiroCanEdit   Boolean @default(true)
  financeiroCanDelete Boolean @default(true)
  /// Overrides por usuário: { modules: { leads: true }, actions: { "leads.export": false } }
  permissions Json?

  lastLoginAt DateTime?

  // Hash do refresh token atual (para logout/refresh seguro).
  hashedRefreshToken String?

  // Proteção contra força bruta: bloqueia a conta após falhas consecutivas.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Fluxo de recuperação de senha.
  passwordResetToken   String?
  passwordResetExpires DateTime?

  // Carteira de leads/clientes atribuídos a este corretor.
  leads Lead[] @relation("LeadCorretor")

  // Leads que este usuário marcou como perdidos.
  leadsPerdidosPor Lead[] @relation("LeadPerdidoPor")

  // Relatos de triagem criados por este corretor.
  triagemEvents TriagemEvent[] @relation("TriagemAutor")

  // Fichas de documentação criadas por este usuário.
  documentacoes Documentacao[] @relation("DocumentacaoAutor")

  // Documentações em que este usuário é o corretor responsável.
  documentacoesComoCorretor Documentacao[] @relation("DocumentacaoCorretor")

  // Documentações em que este usuário é o gerente responsável.
  documentacoesComoGerente Documentacao[] @relation("DocumentacaoGerente")

  // Propostas comerciais criadas por este usuário.
  propostasAutor Proposta[] @relation("PropostaAutor")

  // Propostas em que este usuário é o corretor responsável.
  propostasComoCorretor Proposta[] @relation("PropostaCorretor")

  // Análises registradas por este usuário (auto ou edição).
  analises Analise[] @relation("AnaliseAutor")

  // Análises que este analista assumiu.
  analisesAssumidas Analise[] @relation("AnaliseAnalista")

  // Compromissos da agenda criados por este usuário.
  agendamentos Agendamento[] @relation("AgendamentoAutor")

  // Solicitações de agenda que este gerente/admin aprovou ou recusou.
  agendamentosAprovados Agendamento[] @relation("AgendamentoAprovador")

  // Eventos de admin direcionados especificamente a este gerente.
  agendamentosAlvoGerente Agendamento[] @relation("AgendamentoAlvoGerente")

  // Tarefas atribuídas a este corretor por gerente/admin.
  agendamentosAtribuidos Agendamento[] @relation("AgendamentoAtribuido")

  // Notificações in-app destinadas a este usuário.
  notificacoes Notificacao[] @relation("NotificacaoDestinatario")

  // Adiamentos de prazo de etapa registrados por este usuário.
  leadPrazoAdiamentos LeadPrazoAdiamento[] @relation("LeadPrazoAdiamentoAutor")

  // Metas em que este usuário é o corretor acompanhado.
  metasComoCorretor Meta[] @relation("MetaCorretor")

  // Metas em que este usuário é o gerente alvo.
  metasComoGerente Meta[] @relation("MetaGerente")

  // Metas criadas pelo próprio corretor, gerente ou administração.
  metasCriadas Meta[] @relation("MetaCriador")

  comissoesComoCorretor FinanceiroComissao[] @relation("ComissaoCorretor")
  comissoesComoGerente  FinanceiroComissao[] @relation("ComissaoGerente")

  /// Equipe que este gerente lidera (no máximo uma).
  equipeGerenciada Equipe? @relation("EquipeGerente")

  /// Equipe à qual o corretor pertence.
  equipeId String?
  equipe   Equipe? @relation("EquipeMembros", fields: [equipeId], references: [id], onDelete: SetNull)

  /// Segmentos de presença (tempo logado) do usuário.
  sessionSegments UserSessionSegment[]

  /// Conta Google Calendar do usuário (refresh token por pessoa).
  googleCalendar UserGoogleCalendar?
  oruloToken     UserOruloToken?

  captacoesResponsavel Captacao[] @relation("CaptacaoResponsavel")
  captacaoHistoricos   CaptacaoHistorico[] @relation("CaptacaoHistoricoAutor")
  vendasUsadoResponsavel VendaUsado[] @relation("VendaUsadoResponsavel")
  vendaUsadoHistoricos   VendaUsadoHistorico[] @relation("VendaUsadoHistoricoAutor")
  vendasUsadoVisitas     VendaUsadoVisita[] @relation("VendaUsadoVisitaResponsavel")
  vendasUsadoPropostas   VendaUsadoProposta[] @relation("VendaUsadoPropostaResponsavel")
  vendasUsadoNegociacaoMovimentos VendaUsadoNegociacaoMovimento[] @relation("VendaUsadoNegociacaoMovimentoAutor")
  vendasUsadoFechamentos          VendaUsadoFechamento[] @relation("VendaUsadoFechamentoResponsavel")
  vendasUsadoDocumentosAnalise    VendaUsadoDocumento[] @relation("VendaUsadoDocumentoAnalista")
  vendasUsadoContratosAssinatura  VendaUsadoContrato[] @relation("VendaUsadoContratoAssinatura")
  imovelChavesResponsavel         ImovelChave[] @relation("ImovelChaveResponsavel")
  imovelChaveMovimentos           ImovelChaveMovimento[] @relation("ImovelChaveMovimentoAutor")
  vendasUsadoPosVenda             VendaUsadoPosVenda[] @relation("VendaUsadoPosVendaResponsavel")
  vendasUsadoPosVendaPendencia    VendaUsadoPosVendaPendencia[] @relation("VendaUsadoPosVendaPendenciaResponsavel")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([role])
  @@index([status])
  @@index([equipeId])
  @@index([tenantId])
  @@map("users")
}

/// Trecho contínuo de atividade no sistema (heartbeat).
/// Usado para calcular quanto tempo o usuário ficou logado no dia.
model UserSessionSegment {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Dia civil em America/Sao_Paulo (YYYY-MM-DD).
  dateKey    String
  startedAt  DateTime
  lastSeenAt DateTime
  /// Null enquanto o segmento está aberto (usuário ainda ativo).
  endedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, dateKey])
  @@index([userId, dateKey])
  @@index([userId, endedAt])
  @@map("user_session_segments")
}

/// Equipe comercial: um gerente e vários corretores.
/// Só o admin cria/edita; o gerente enxerga apenas os processos dos membros.
model Equipe {
  id       String     @id @default(uuid())
  tenantId String
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  status   UserStatus @default(ativo)

  gerenteId String @unique
  gerente   User   @relation("EquipeGerente", fields: [gerenteId], references: [id], onDelete: Restrict)

  membros User[] @relation("EquipeMembros")

  /// Leads no pool da equipe (aguardando distribuição aos corretores).
  leads Lead[]

  /// Eventos de admin direcionados a esta equipe.
  agendamentosAlvo Agendamento[] @relation("AgendamentoAlvoEquipe")

  comissoes FinanceiroComissao[]

  /// Funis de operação configurados para esta equipe (no máximo um por tipo).
  funis EquipeFunil[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([tenantId])
  @@map("equipes")
}

/// Contato comercial (lead de captação ou cliente da carteira).
/// stage, interesse e prioridade são strings validadas na API (paridade 1:1
/// com os identificadores usados no frontend, inclusive acentos e hífens).
model Lead {
  id         String      @id @default(uuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// lead = captação; cliente = carteira pessoal do corretor.
  tipo       ContatoTipo @default(lead)
  nome       String
  telefone   String
  email      String
  origem     String
  interesse  String // Comprar (New Palace trabalha só com vendas)
  cidade     String
  bairro     String
  stage      String      @default("novo")
  prioridade String      @default("Média")
  /// Renda mensal informada pelo cliente (opcional).
  renda      Int?
  /// Tipo de renda (CLT, autônomo, etc.) — opcional.
  tipoRenda  String?
  /// Estado civil informado pelo cliente (opcional).
  estadoCivil String?
  /// Orçamento máximo para imóvel (opcional) — usado no matching.
  orcamentoMax Int?
  /// Mínimo de quartos desejado (opcional).
  quartosMin   Int?
  /// Mínimo de vagas desejado (opcional).
  vagasMin     Int?
  /// Prospecção B2B (imobiliária) — usada no tenant da plataforma.
  prospeccao Json?
  tags       String[]    @default([])

  // Corretor dono do lead. Fica nulo se o corretor for removido (SetNull),
  // preservando o histórico do lead.
  corretor   User?   @relation("LeadCorretor", fields: [corretorId], references: [id], onDelete: SetNull)
  corretorId String?

  /// Pool da equipe (admin distribuiu à equipe; gerente ainda não atribuiu corretor).
  equipeId String?
  equipe   Equipe? @relation(fields: [equipeId], references: [id], onDelete: SetNull)

  /// Imóvel de interesse (preenchido ao enviar para análise).
  construtoraId String?
  construtora   Construtora? @relation(fields: [construtoraId], references: [id], onDelete: SetNull)

  empreendimentoId String?
  empreendimento   Empreendimento? @relation(fields: [empreendimentoId], references: [id], onDelete: SetNull)

  /// Soft-delete operacional: some do funil/listas de corretor e gerente.
  /// Só admin consulta via módulo Leads Perdidos.
  perdidoAt    DateTime?
  motivoPerda  String?
  perdidoPor   User?     @relation("LeadPerdidoPor", fields: [perdidoPorId], references: [id], onDelete: SetNull)
  perdidoPorId String?

  /// Momento em que o lead entrou na etapa atual (não usa createdAt como movimentação contínua).
  stageEnteredAt DateTime @default(now())
  /// Última movimentação relevante (etapa, triagem, tarefa ou atividade).
  lastMovementAt DateTime @default(now())
  lastStageChangeAt DateTime?
  lastTriagemAt     DateTime?
  lastTarefaAt      DateTime?
  lastAtividadeAt   DateTime?
  /// Deadline efetivo da etapa (calculado ou adiado). Null = etapa sem prazo.
  prazoDueAt DateTime?
  /// Início da janela "próximo do vencimento".
  alertaProximoAt DateTime?
  /// true quando o prazo atual veio de um adiamento (não recalcular pela etapa).
  prazoAdiado Boolean @default(false)

  triagemEvents TriagemEvent[]
  prazoAdiamentos LeadPrazoAdiamento[]
  documentacoes Documentacao[]
  propostas     Proposta[]
  analise       Analise?
  agendamentos  Agendamento[]
  notificacoes  Notificacao[]
  ozapLink      LeadOzapLink?
  metaLink      LeadMetaLink?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, tipo])
  @@index([tenantId, stage])
  @@index([tenantId, lastMovementAt])
  @@index([tenantId, prazoDueAt])
  @@index([tenantId, alertaProximoAt])
  @@index([tipo])
  @@index([stage])
  @@index([corretorId])
  @@index([equipeId])
  @@index([construtoraId])
  @@index([empreendimentoId])
  @@index([createdAt])
  @@index([perdidoAt])
  @@map("leads")
}

/// Histórico de adiamentos do prazo de permanência na etapa.
model LeadPrazoAdiamento {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId   String
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  autorId  String
  autor    User   @relation("LeadPrazoAdiamentoAutor", fields: [autorId], references: [id], onDelete: Cascade)

  prazoAnteriorAt      DateTime?
  prazoNovoAt          DateTime
  prazoAnteriorValor   Int?
  prazoAnteriorUnidade PrazoUnidade?
  prazoNovoValor       Int
  prazoNovoUnidade     PrazoUnidade
  motivo               String?

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([tenantId])
  @@index([autorId])
  @@map("lead_prazo_adiamentos")
}

/// Vínculo entre um lead do CRM e o chat correspondente na instância OZap.
model LeadOzapLink {
  id String @id @default(uuid())

  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  instanceId Int
  chatId     String
  categoria  String?
  /// Campo do lead solicitado pela última pergunta enviada pela IA.
  campoPendente String?

  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([instanceId, chatId])
  @@index([instanceId])
  @@map("lead_ozap_links")
}

/// Entrega recebida do webhook OZap, usada para impedir duplicação por retry.
model OzapWebhookDelivery {
  id String @id @default(uuid())

  deliveryKey String @unique
  event       String
  instanceId  Int
  chatId      String?
  messageId   String?
  payload     Json
  processedAt DateTime @default(now())

  @@index([instanceId, event])
  @@map("ozap_webhook_deliveries")
}

/// Vínculo entre um lead do CRM e um leadgen do Meta Lead Ads.
model LeadMetaLink {
  id String @id @default(uuid())

  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  leadgenId String  @unique
  pageId    String
  formId    String?
  adId      String?
  adgroupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
  @@index([formId])
  @@map("lead_meta_links")
}

/// Entrega recebida do webhook Meta, usada para impedir duplicação por retry.
model MetaWebhookDelivery {
  id String @id @default(uuid())

  deliveryKey String @unique
  leadgenId   String
  pageId      String
  formId      String?
  payload     Json
  processedAt DateTime @default(now())

  @@index([pageId])
  @@index([leadgenId])
  @@map("meta_webhook_deliveries")
}

/// Origem do relato de triagem (após avanço no funil ou criação manual).
enum TriagemOrigem {
  funil
  manual
}

/// Relato do corretor sobre um lead/cliente (histórico na Triagem).
model TriagemEvent {
  id            String        @id @default(uuid())
  leadId        String
  lead          Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  autorId       String
  autor         User          @relation("TriagemAutor", fields: [autorId], references: [id], onDelete: Cascade)
  texto         String
  /// Texto imediatamente anterior à última edição (visível a admin/gerente).
  textoAnterior String?
  stageAnterior String?
  stageNovo     String?
  origem        TriagemOrigem
  createdAt     DateTime      @default(now())
  editedAt      DateTime?

  @@index([leadId])
  @@index([autorId])
  @@index([createdAt])
  @@map("triagem_events")
}

/// Construtora parceira (cadastro admin; gerente só visualiza).
model Construtora {
  id                  String  @id @default(uuid())
  tenantId            String
  tenant              Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome                String
  /// Cor de destaque em hex (#RRGGBB) para badges na documentação.
  cor                 String?
  contato             String?
  endereco            String?
  viabilizadorNome    String?
  viabilizadorContato String?
  /// CCA cadastrado em Configurações (label do catálogo).
  cca                 String?
  /// Pasta do Google Drive (hub de arquivos por construtora).
  driveFolderUrl      String?
  /// Logo única (Cloudinary).
  logoUrl             String?
  logoPublicId        String?

  empreendimentos Empreendimento[]
  documentacoes   Documentacao[]
  propostas       Proposta[]
  leads           Lead[]
  localidades     Localidade[] @relation("ConstrutoraLocalidades")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([nome])
  @@map("construtoras")
}

/// Região / cidade de atuação. Várias construtoras podem compartilhar a mesma localidade.
model Localidade {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome     String

  construtoras    Construtora[]     @relation("ConstrutoraLocalidades")
  empreendimentos Empreendimento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, nome])
  @@index([tenantId])
  @@index([nome])
  @@map("localidades")
}

/// Empreendimento / imóvel (cadastro manual + vínculo opcional à construtora).
model Empreendimento {
  id            String  @id @default(uuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome          String
  /// Cor de destaque em hex (#RRGGBB) para badges na documentação.
  cor           String?
  construtoraId String?
  construtora   Construtora? @relation(fields: [construtoraId], references: [id], onDelete: SetNull)

  localidadeId String?
  localidade   Localidade? @relation(fields: [localidadeId], references: [id], onDelete: SetNull)

  cidade      String?
  endereco    String?
  tipo        String?
  status      String?
  previsaoEntrega DateTime? @db.Date
  tags        String[] @default([])
  observacao  String?
  quartos     Int?
  banheiros   Int?
  /// Vagas de garagem (opcional) — usado no matching.
  vagas       Int?
  /// Preço de referência do produto (opcional) — usado no matching.
  valorReferencia Int?
  /// Renda mínima sugerida para o cliente (opcional).
  rendaAPartirDe Int?
  areaM2      Float?
  externalUrl String?
  /// Capa (primeira da galeria). Mantida para listagens.
  imagemUrl   String?
  /// Galeria (máx. 2): [{ "url": string, "publicId": string }]
  imagens     Json    @default("[]")
  /// Chave estável interna (ex.: manual-slug-timestamp).
  externalKey String
  ativo       Boolean @default(true)
  /// ID imutável do empreendimento na Órulo (quando originado do catálogo).
  oruloBuildingId   Int?
  oruloImageIds     String[]  @default([])
  oruloFloorPlanIds String[]  @default([])
  /// active | removed | excluded
  oruloStatus       String?
  oruloSyncedAt     DateTime?

  documentacoes Documentacao[]
  propostas     Proposta[]
  leads         Lead[]
  notificacoes  Notificacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, externalKey])
  @@unique([tenantId, oruloBuildingId])
  @@index([tenantId])
  @@index([construtoraId])
  @@index([localidadeId])
  @@index([ativo])
  @@index([nome])
  @@index([oruloBuildingId])
  @@map("empreendimentos")
}

/// Ficha de documentação operacional (campos da planilha), vinculada a lead/cliente.
model Documentacao {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId   String
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  autorId  String
  autor    User   @relation("DocumentacaoAutor", fields: [autorId], references: [id], onDelete: Cascade)

  /// Snapshot do tipo e etapa do funil no momento do cadastro.
  tipoContato   ContatoTipo
  stageSituacao String

  nome String

  construtoraId String?
  construtora   Construtora? @relation(fields: [construtoraId], references: [id], onDelete: SetNull)

  empreendimentoId String?
  empreendimento   Empreendimento? @relation(fields: [empreendimentoId], references: [id], onDelete: SetNull)

  /// Fonte configurável (catálogo documentacao_fonte; label livre).
  fonte   String @default("Outro")
  /// Status de crédito/análise (texto livre; catálogo documentacao_status1).
  status1 String @default("Análise")
  /// Status comercial (texto livre; catálogo documentacao_status2).
  status2 String @default("Andamento")

  corretorId String?
  corretor   User? @relation("DocumentacaoCorretor", fields: [corretorId], references: [id], onDelete: SetNull)

  gerenteId String?
  gerente   User? @relation("DocumentacaoGerente", fields: [gerenteId], references: [id], onDelete: SetNull)

  dataAnalise DateTime?
  dataVenda   DateTime?
  /// VGV em reais (inteiro).
  vgv Int?
  obs String?

  temEntrada    Boolean @default(false)
  valorEntrada  Int?
  temFgts       Boolean @default(false)
  valorFgts     Int?
  temDependente Boolean @default(false)

  comissoes FinanceiroComissao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([leadId])
  @@index([autorId])
  @@index([construtoraId])
  @@index([empreendimentoId])
  @@index([corretorId])
  @@index([gerenteId])
  @@index([createdAt])
  @@map("documentacoes")
}

/// Status comercial da proposta.
enum PropostaStatus {
  rascunho
  enviada
  negociacao
  aceita
  recusada
  expirada
}

/// Proposta comercial enviada a lead/cliente.
model Proposta {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Código legível (ex.: PROP-2026-0042).
  codigo String

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  clienteNome     String
  clienteTelefone String?
  clienteCpf                 String?
  clienteRg                  String?
  clienteRgOrgaoEmissor      String?
  clienteDataNascimento      DateTime?
  clienteNacionalidade       String?
  clienteEstadoCivil         String?
  clienteRegimeBens          String?
  clienteDataCasamento       DateTime?
  clienteNomePai             String?
  clienteNomeMae             String?
  clienteRenda               Float?
  clienteTelefoneFixo        String?
  clienteEmail               String?
  clienteEnderecoResidencial String?
  clienteBairroResidencial   String?
  clienteCidadeResidencial   String?
  clienteUfResidencial       String?
  clienteCepResidencial      String?
  clienteCobrancaResidencial Boolean?
  clienteEmpregador          String?
  clienteProfissao           String?
  clienteEnderecoComercial   String?
  clienteBairroComercial     String?
  clienteCidadeComercial     String?
  clienteUfComercial         String?
  clienteCepComercial        String?
  clienteCobrancaComercial   Boolean?
  clienteSite                String?
  clienteTelefoneComercial1  String?
  clienteTelefoneComercial2  String?

  construtoraId String?
  construtora   Construtora? @relation(fields: [construtoraId], references: [id], onDelete: SetNull)

  empreendimentoId String?
  empreendimento   Empreendimento? @relation(fields: [empreendimentoId], references: [id], onDelete: SetNull)

  unidade String?

  corretorId String?
  corretor   User?   @relation("PropostaCorretor", fields: [corretorId], references: [id], onDelete: SetNull)

  autorId String
  autor   User   @relation("PropostaAutor", fields: [autorId], references: [id], onDelete: Cascade)

  /// Valores em reais (inteiros).
  /// valor = valor de venda; entrada = sinal.
  valor          Int
  entrada        Int?
  apartado       Int?
  /// Parcelas pré-chaves (vários valores).
  preChaves      Int[] @default([])
  /// Parcelas pós-chaves (vários valores).
  posChaves      Int[] @default([])
  /// Parcelas intercaladas (vários valores).
  intercaladas   Int[] @default([])
  fgts           Int?
  moraBem        Int?
  mcmv           Int?
  /// Informativo; pode ter centavos (ex.: 569.99).
  parcelaCaixa   Float?
  financiamento  Int?
  /// Desconto do empreendimento (R$), à parte da composição.
  desconto       Int?

  status    PropostaStatus @default(rascunho)
  validade  DateTime?
  enviadaEm DateTime?
  observacao String?

  notificacoes Notificacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@index([leadId])
  @@index([corretorId])
  @@index([autorId])
  @@index([status])
  @@index([createdAt])
  @@index([validade])
  @@map("propostas")
}

/// Status do parecer da análise de crédito/cadastro.
enum AnaliseStatus {
  pendente
  em_analise
  aprovado
  reprovado
}

/// Ficha de análise gerada ao entrar na etapa "Em análise" do funil.
/// Guarda snapshot do cadastro (+ dados financeiros da documentação, se houver).
model Analise {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId   String @unique
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  autorId  String
  autor    User   @relation("AnaliseAutor", fields: [autorId], references: [id], onDelete: Cascade)

  /// Analista que assumiu o processo (pendente → em_analise).
  analistaId String?
  analista   User?  @relation("AnaliseAnalista", fields: [analistaId], references: [id], onDelete: SetNull)

  tipoContato   ContatoTipo
  stageSituacao String

  nome       String
  telefone   String
  email      String
  origem     String
  interesse  String
  cidade     String
  bairro     String
  prioridade String
  renda      Int?
  tags       String[] @default([])

  temFgts       Boolean @default(false)
  valorFgts     Int?
  temEntrada    Boolean @default(false)
  valorEntrada  Int?
  temDependente Boolean @default(false)

  status  AnaliseStatus @default(pendente)
  parecer String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([autorId])
  @@index([analistaId])
  @@index([status])
  @@index([createdAt])
  @@map("analises")
}

/// Tipo de compromisso na Agenda.
enum AgendamentoTipo {
  visita
  ligacao
  reuniao
  tarefa
  outro
  /// Horário travado (admin/gerente) — impede novos agendamentos sobrepostos.
  bloqueio
}

/// Frequência de materialização de bloqueios recorrentes.
enum AgendamentoRecurrenceFreq {
  unica
  semanal
  mensal
}

/// Situação operacional do compromisso.
enum AgendamentoStatus {
  agendado
  concluido
  cancelado
}

/// Quem participa / se exige gerente.
enum AgendamentoEscopo {
  /// Tarefa do corretor (ex.: ligar para o cliente) — sem aprovação.
  pessoal
  /// Envolve o gerente (visita/reunião) — corretor solicita, gerente aprova.
  com_gerente
}

/// Público de eventos criados pelo admin.
enum AgendamentoAlvo {
  /// Compromisso normal (não é evento broadcast do admin).
  nenhum
  /// Visível para todos os usuários.
  todos
  /// Visível para gerente + corretores da equipe.
  equipe
  /// Visível somente para o gerente indicado (+ admin).
  gerente
  /// Visível para todos os gerentes (+ admin); corretores não veem.
  gerentes
}

/// Fluxo de solicitação quando escopo = com_gerente.
enum AgendamentoSolicitacaoStatus {
  nenhuma
  pendente
  aprovada
  recusada
}

/// Compromisso vinculado a um lead/cliente (visita, ligação, reunião, tarefa…).
/// leadId é opcional para tarefas pessoais sem contato (ex.: "fazer lista").
model Agendamento {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId   String?
  lead     Lead?  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  autorId  String
  autor    User   @relation("AgendamentoAutor", fields: [autorId], references: [id], onDelete: Cascade)

  /// Corretor responsável quando gerente/admin atribui a tarefa.
  atribuidoParaId String?
  atribuidoPara   User?   @relation("AgendamentoAtribuido", fields: [atribuidoParaId], references: [id], onDelete: SetNull)

  titulo       String
  tipo         AgendamentoTipo              @default(visita)
  status       AgendamentoStatus            @default(agendado)
  escopo       AgendamentoEscopo            @default(pessoal)
  solicitacaoStatus AgendamentoSolicitacaoStatus @default(nenhuma)

  /// Público de eventos do admin (nenhum nos compromissos normais).
  alvoTipo      AgendamentoAlvo @default(nenhum)
  alvoEquipeId  String?
  alvoEquipe    Equipe? @relation("AgendamentoAlvoEquipe", fields: [alvoEquipeId], references: [id], onDelete: SetNull)
  alvoGerenteId String?
  alvoGerente   User?   @relation("AgendamentoAlvoGerente", fields: [alvoGerenteId], references: [id], onDelete: SetNull)

  /// Agrupa ocorrências materializadas de um bloqueio recorrente.
  seriesId         String?
  recurrenceFreq   AgendamentoRecurrenceFreq @default(unica)
  /// Dias da semana 0–6 (Dom–Sáb) quando recurrenceFreq = semanal.
  recurrenceDays   Int[]                     @default([])
  recurrenceUntil  DateTime?

  startsAt     DateTime
  endsAt       DateTime?
  local        String?
  observacoes  String?
  /// Etapa do funil no momento da criação (quando originada no quadro).
  funilStage   String?

  aprovadoPorId String?
  aprovadoPor   User?     @relation("AgendamentoAprovador", fields: [aprovadoPorId], references: [id], onDelete: SetNull)
  aprovadoAt    DateTime?
  motivoRecusa  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  googleCalendarEvents UserGoogleCalendarEvent[]

  @@index([tenantId])
  @@index([leadId])
  @@index([autorId])
  @@index([atribuidoParaId])
  @@index([seriesId])
  @@index([startsAt])
  @@index([status])
  @@index([tipo])
  @@index([escopo])
  @@index([solicitacaoStatus])
  @@index([alvoTipo])
  @@index([alvoEquipeId])
  @@index([alvoGerenteId])
  @@map("agendamentos")
}

/// Conexão OAuth do Google Calendar — um refresh token por usuário CRM.
model UserGoogleCalendar {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail     String
  refreshTokenEnc String
  calendarId      String   @default("primary")
  connectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
  events          UserGoogleCalendarEvent[]

  @@map("user_google_calendars")
}

/// Mapeia um agendamento do CRM para o evento correspondente no Google.
model UserGoogleCalendarEvent {
  id            String @id @default(uuid())
  connectionId  String
  connection    UserGoogleCalendar @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  agendamentoId String
  agendamento   Agendamento        @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  googleEventId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([agendamentoId, connectionId])
  @@index([connectionId])
  @@index([agendamentoId])
  @@map("user_google_calendar_events")
}

/// Tipo de notificação in-app.
enum NotificacaoTipo {
  analise_resultado
  agenda_solicitacao
  agenda_resposta
  agenda_atribuicao
  agenda_lembrete_1d
  agenda_lembrete_2h
  agenda_lembrete_1h
  lead_prazo_proximo
  lead_prazo_ultrapassado
  lead_sem_atendimento
  tarefa_atrasada
  imovel_compativel
  proposta_vencimento_proximo
}

/// Aviso in-app para o usuário (ex.: resultado da análise para o corretor).
model Notificacao {
  id       String          @id @default(uuid())
  tenantId String
  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User            @relation("NotificacaoDestinatario", fields: [userId], references: [id], onDelete: Cascade)
  tipo     NotificacaoTipo
  titulo   String
  corpo    String
  lida     Boolean         @default(false)

  leadId         String?
  lead           Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  analiseId      String?
  agendamentoId  String?
  empreendimentoId String?
  empreendimento   Empreendimento? @relation(fields: [empreendimentoId], references: [id], onDelete: SetNull)
  propostaId     String?
  proposta       Proposta? @relation(fields: [propostaId], references: [id], onDelete: SetNull)
  /// Fingerprint do evento (ex.: stageEnteredAt|prazoDueAt) para impedir duplicatas.
  eventoChave    String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId, lida])
  @@index([userId, leadId, tipo, eventoChave])
  @@index([userId, empreendimentoId, tipo, eventoChave])
  @@index([userId, propostaId, tipo, eventoChave])
  @@index([createdAt])
  @@map("notificacoes")
}

/// Tipos de catálogo configuráveis pelo admin/gerente na tela de Configurações.
enum CatalogType {
  funil_etapa
  origem
  motivo_perda
  tag
  documentacao_fonte
  documentacao_status1
  documentacao_status2
  cca
  empreendimento_tipo
  empreendimento_status
  empreendimento_tag
}

/// Papel semântico da etapa no funil — dispara fluxos (análise, venda, perda)
/// independentemente do slug/label personalizados.
enum FunilEtapaPapel {
  inicial
  analise
  venda
  perdido
}

/// Tipo de operação do funil. Um funil ativo por (tenant, tipo).
enum FunilTipo {
  comercial
  captacao
  venda_usados
}

/// Funil nomeado do tenant. Um `ativo` por tipo de operação.
model Funil {
  id       String    @id @default(uuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  /// Operação à qual este funil pertence (comercial = CRM atual).
  tipo     FunilTipo @default(comercial)
  /// Funil em uso no kanban/dashboard daquele tipo.
  ativo    Boolean   @default(false)
  /// Sem movimentação relevante após este período gera alerta no card.
  inatividadeValor   Int          @default(48)
  inatividadeUnidade PrazoUnidade @default(horas)

  etapas FunilEtapa[]
  captacoes Captacao[]
  vendasUsado VendaUsado[]
  equipeFunis EquipeFunil[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, ativo])
  @@index([tenantId, tipo])
  @@map("funis")
}

/// Etapa pertencente a um funil. Lead.stage guarda o `slug`.
model FunilEtapa {
  id        String           @id @default(uuid())
  funilId   String
  funil     Funil            @relation(fields: [funilId], references: [id], onDelete: Cascade)
  label     String
  slug      String
  color     String           @default("bg-slate-200 text-slate-700")
  sortOrder Int              @default(0)
  active    Boolean          @default(true)
  /// null = etapa intermediária sem fluxo especial.
  papel     FunilEtapaPapel?
  /// Prazo máximo de permanência. Null = etapa sem SLA.
  prazoValor Int?
  prazoUnidade PrazoUnidade @default(horas)
  /// Percentual restante do prazo para disparar alerta laranja (1–90).
  alertaAntecedenciaPercent Int @default(20)

  captacoes Captacao[]
  vendasUsado VendaUsado[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([funilId, slug])
  @@unique([funilId, label])
  @@index([funilId, sortOrder])
  @@index([funilId, papel])
  @@map("funil_etapas")
}

/// Vínculo equipe → funil (um funil por tipo de operação em cada equipe).
model EquipeFunil {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  equipeId String
  equipe   Equipe @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  funilId  String
  funil    Funil  @relation(fields: [funilId], references: [id], onDelete: Cascade)
  /// Cópia do tipo do funil para garantir um vínculo por operação.
  tipo     FunilTipo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, equipeId, funilId])
  @@unique([equipeId, tipo])
  @@index([tenantId, equipeId])
  @@index([funilId])
  @@map("equipe_funis")
}

enum PessoaTipo {
  fisica
  juridica
}

/// Tipo do imóvel individual captado (não confundir com empreendimento/lançamento).
enum CaptacaoImovelTipo {
  apartamento
  casa
  terreno
  sala_comercial
  loja
  galpao
  fazenda
  chacara
  outro
}

enum CaptacaoHistoricoTipo {
  criacao
  etapa
  responsavel
  valor
  exclusividade
  edicao
  portal_acao
  cancelamento
}

/// Pessoa ou empresa dona do imóvel. Base do futuro Portal do Proprietário.
model Proprietario {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome        String
  tipoPessoa  PessoaTipo @default(fisica)
  cpfCnpj     String     @default("")
  telefone    String     @default("")
  email       String     @default("")
  observacoes String     @default("")

  imoveis      Imovel[]
  captacoes    Captacao[]
  posVendas    VendaUsadoPosVenda[]
  portalAcesso ProprietarioPortalAcesso?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, nome])
  @@map("proprietarios")
}

enum ProprietarioPortalStatus {
  ativo
  inativo
}

/// Credenciais do Portal do Proprietário (não mistura com User interno).
model ProprietarioPortalAcesso {
  id                   String                   @id @default(uuid())
  tenantId             String
  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proprietarioId       String                   @unique
  proprietario         Proprietario             @relation(fields: [proprietarioId], references: [id], onDelete: Cascade)
  password             String
  hashedRefreshToken   String?
  status               ProprietarioPortalStatus @default(inativo)
  lastLoginAt          DateTime?
  novidadesLidasAt     DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("proprietario_portal_acessos")
}

/// Imóvel individual vinculado a um proprietário do tenant.
model Imovel {
  id              String             @id @default(uuid())
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proprietarioId  String
  proprietario    Proprietario       @relation(fields: [proprietarioId], references: [id], onDelete: Restrict)
  tipo            CaptacaoImovelTipo
  cep             String             @default("")
  logradouro      String             @default("")
  numero          String             @default("")
  complemento     String             @default("")
  bairro          String             @default("")
  cidade          String             @default("")
  estado          String             @default("")
  area            Decimal?           @db.Decimal(12, 2)
  areaConstruida  Decimal?           @db.Decimal(12, 2)
  quartos         Int?
  suites          Int?
  banheiros       Int?
  vagas           Int?
  /// Texto de anúncio (captação e venda de usados).
  descricao       String             @default("")
  /// Lazer e características da unidade (rooftop, vestíbulo, etc.).
  comodidadesUnidade     String[]    @default([])
  /// Infraestrutura do condomínio/empreendimento.
  comodidadesCondominio  String[]    @default([])
  observacoes     String             @default("")
  /// Ex.: Condomínio (visão geral, distinto do tipo do imóvel).
  tipoEmpreendimento String          @default("")
  aptsPorAndar    Int?
  andares         Int?
  torres          Int?
  fotoUrl         String?
  fotoPublicId    String?
  fotos           ImovelFoto[]

  captacoes Captacao[]
  vendaUsado VendaUsado?
  chaves     ImovelChave[]
  posVendas  VendaUsadoPosVenda[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, proprietarioId])
  @@index([tenantId, cidade])
  @@index([tenantId, tipo])
  @@map("imoveis")
}

/// Até 4 fotos por imóvel (capa = sortOrder 0). A imobiliária envia; o dono não.
model ImovelFoto {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  imovelId  String
  imovel    Imovel   @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([imovelId, sortOrder])
  @@index([tenantId, imovelId])
  @@map("imovel_fotos")
}

/// Processo de captação do imóvel para a imobiliária (funil tipo captacao).
model Captacao {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proprietarioId   String
  proprietario     Proprietario @relation(fields: [proprietarioId], references: [id], onDelete: Restrict)
  imovelId         String
  imovel           Imovel    @relation(fields: [imovelId], references: [id], onDelete: Restrict)
  responsavelId    String
  responsavel      User      @relation("CaptacaoResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict)
  /// Label do catálogo de origens (mesmo padrão de Lead.origem).
  origem           String    @default("")
  /// Imóvel sugerido pelo dono no portal (card com tag no funil).
  sugestaoProprietario Boolean @default(false)
  /// Dono desistiu de anunciar pelo portal; o corretor dá perda ou tenta negociar.
  canceladoPeloProprietario Boolean @default(false)
  motivoPerda String @default("")
  exclusividade    Boolean   @default(false)
  valorPretendido  Decimal?  @db.Decimal(14, 2)
  valorAvaliacao   Decimal?  @db.Decimal(14, 2)
  funilId          String
  funil            Funil     @relation(fields: [funilId], references: [id], onDelete: Restrict)
  funilEtapaId     String
  funilEtapa       FunilEtapa @relation(fields: [funilEtapaId], references: [id], onDelete: Restrict)

  stageEnteredAt    DateTime @default(now())
  lastStageChangeAt DateTime @default(now())
  lastMovementAt    DateTime @default(now())
  lastHistoricoAt   DateTime?
  prazoDueAt        DateTime?
  alertaProximoAt   DateTime?
  prazoAdiado       Boolean  @default(false)

  historicos CaptacaoHistorico[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, proprietarioId])
  @@index([tenantId, imovelId])
  @@index([tenantId, responsavelId])
  @@index([tenantId, funilEtapaId])
  @@index([tenantId, createdAt])
  @@index([tenantId, lastMovementAt])
  @@index([tenantId, prazoDueAt])
  @@map("captacoes")
}

model CaptacaoHistorico {
  id         String                @id @default(uuid())
  tenantId   String
  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  captacaoId String
  captacao   Captacao              @relation(fields: [captacaoId], references: [id], onDelete: Cascade)
  tipo       CaptacaoHistoricoTipo
  texto      String
  autorId    String?
  autor      User?                 @relation("CaptacaoHistoricoAutor", fields: [autorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId, captacaoId])
  @@index([captacaoId, createdAt])
  @@map("captacao_historicos")
}

