  status          VendaUsadoDocumentoStatus      @default(pendente)
  observacao      String                         @default("")
  dataSolicitacao DateTime                       @default(now())
  dataRecebimento DateTime?
  dataAnalise     DateTime?

  createdAt DateTime @default(now())
