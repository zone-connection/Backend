# Ambiente: development | production
NODE_ENV=development

# Banco de dados PostgreSQL
# Render: use a Internal Database URL quando a API roda no mesmo região do banco
# (sem host público e sem porta) — corta a latência de saída pela internet.
DATABASE_URL="postgresql://postgres:senha@localhost:5432/crm_newpalace?schema=public"

# Servidor
PORT=3333
# Loopback em dev (API não fica exposta na rede). Em container/PaaS use 0.0.0.0
# No Render: HOST=0.0.0.0 e NÃO defina PORT (a plataforma injeta a dela).
HOST=127.0.0.1

# Origens permitidas no CORS (separadas por vírgula).
# Obrigatório em produção — em dev qualquer porta de localhost é aceita.
FRONTEND_URL="http://localhost:8080,https://frontend-seven-wine-46.vercel.app"

# SameSite dos cookies de sessão: lax | none | strict.
# Com Vercel /api (HTTPS) o código força lax — COOKIE_SAMESITE=none sem Secure
# é recusado pelo Firefox. Use none só se o browser chamar a API em outro host.

# JWT — gere valores únicos com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Mínimo de 32 caracteres e OBRIGATORIAMENTE diferentes entre si.
JWT_ACCESS_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="7d"

# Senha padrão dos usuários criados pelo seed (apenas desenvolvimento local)
SEED_DEFAULT_PASSWORD="Mudar@123"

# Admin de plataforma (super_admin) — criado/atualizado no boot da API.
# Sem tenant; gerencia tenants e conexões Meta/OZap via API /api/tenants.
# Ex.: BOOTSTRAP_ADMIN_EMAIL=admin@zoneconnection.com
BOOTSTRAP_ADMIN_EMAIL="admin@zoneconnection.com"
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="Zone Connection"

# OZap Online — configure o mesmo segredo no webhook de saída do painel OZap.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OZAP_WEBHOOK_SECRET=""
# Necessária apenas para comandos do CRM para o OZap (envio de mensagens, pausa da IA).
OZAP_API_KEY=""
# Usado no boot para seed da TenantOzapConnection do tenant default (new-palace).
# Depois do seed, a fonte de verdade é a tabela tenant_ozap_connections.
OZAP_INSTANCE_ID=1143

# Meta Lead Ads — webhook em POST/GET /api/webhooks/meta
# META_APP_SECRET + META_VERIFY_TOKEN ficam no env (app único).
# META_PAGE_ID + META_PAGE_ACCESS_TOKEN: seed inicial da TenantMetaConnection
# do tenant default; depois gerencie via API /api/tenants/:id/meta-connections.
# META_PAGE_ID também roteia o ping dummy da ferramenta de teste (444444444444).
# META_GRAPH_API_VERSION: opcional (padrão v22.0).
# META_LEAD_POLL_ENABLED=false desliga a puxada periódica pela Graph API.
# META_LEAD_POLL_INTERVAL_MS padrão 120000 (2 min). Mínimo 30000.
META_APP_SECRET=""
META_VERIFY_TOKEN=""
META_PAGE_ACCESS_TOKEN=""
META_PAGE_ID=""
# META_GRAPH_API_VERSION="v22.0"
# OAuth (Conectar Facebook) — mesmo app do webhook. Redirects no Meta for Developers.
META_APP_ID=""
META_OAUTH_REDIRECT_URIS="http://localhost:8080/api/integrations/meta/callback,https://www.zoneconnection.com.br/api/integrations/meta/callback,https://frontend-seven-wine-46.vercel.app/api/integrations/meta/callback"

# Órulo — catálogo (credenciais por tenant no CRM).
# BACKEND_PUBLIC_URL: URL pública da API (webhook informado ao time da Órulo).
# ORULO_REDIRECT_URI: callback do corretor (oruloEndUserAuth); padrão FRONTEND_URL/configuracoes?...
# BACKEND_PUBLIC_URL="https://api.exemplo.com"
# ORULO_REDIRECT_URI="https://app.exemplo.com/configuracoes?secao=conta&item=conexoes&orulo=callback"

# Cloudinary — upload de fotos de empreendimentos (máx. 2) e logo da construtora (máx. 1).
# Crie em https://cloudinary.com e preencha as três variáveis (painel → API Keys).
# Sem isso, o CRM sobe, mas o envio de imagens retorna erro de configuração.
# No Dokploy: Environment da API → as três variáveis → novo deploy.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Calendar — OAuth web (mesmo client para local e produção).
# Redirects autorizados no Google Cloud, separados por vírgula.
# Não use o host da API (sslip.io / Render); o browser volta para o frontend /api.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URIS="http://localhost:8080/api/integrations/google/callback,https://www.zoneconnection.com.br/api/integrations/google/callback,https://frontend-seven-wine-46.vercel.app/api/integrations/google/callback"
